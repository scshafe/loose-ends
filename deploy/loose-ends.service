# Sample systemd *user* unit for the loose-ends service (Linux).
#
# Install:
#   cp deploy/loose-ends.service ~/.config/systemd/user/loose-ends.service
#   # edit ExecStart to your binary path
#   systemctl --user daemon-reload
#   systemctl --user enable --now loose-ends.service
#   loginctl enable-linger "$USER"   # keep it running when you're not logged in
#
# Config is read from ~/.config/loose-ends/config.toml; the Tailscale auth key
# (first run only) from ~/.config/loose-ends/tsnet.authkey.

[Unit]
Description=Loose Ends task service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/loose-ends serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
