# Only needed if you use the ALTERNATIVE auth-key delivery (env, not file mount).
# Copy to .env (gitignored), paste your key, and enable `env_file: .env` +
# comment out the tsnet.authkey volume in docker-compose.yml. See README.md.
#
# Prefer the default file-mount method unless a uid mismatch blocks it: a key in
# an env var is visible via `docker inspect`, whereas the mounted file is not.
TS_AUTHKEY=tskey-auth-REPLACE-ME
